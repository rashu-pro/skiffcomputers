{
    "name": "skiffcomputers/skifftech-pos-sync-for-woocommerce",
    "description": "OAuth2 client-credentials authorization server for the POS WooCommerce sync REST API.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "league/oauth2-server": ">=9.0.0,<9.4.0",
        "lcobucci/jwt": ">=5.0.0,<5.4.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "lcobucci/clock": ">=3.0.0,<3.1.0"
    },
    "autoload": {
        "psr-4": {
            "PosSync\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
